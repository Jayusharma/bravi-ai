## 10. Copy-Paste Templates

### Add a New Backend Module

```typescript
// ── 1. Controller ──
@Controller('report')
@UseGuards(CaslGuard)
export class ReportController {
  constructor(private reportService: ReportService) {}

  @Get()
  @CheckAbility({ action: 'read', subject: 'Report' })
  findAll(@Query() query: any, @Req() req: Request) {
    return this.reportService.findAll(query, req.ability);
  }

  @Get(':id')
  @CheckAbility({ action: 'read', subject: 'Report' })
  findOne(@Param('id') id: string) {
    return this.reportService.findOne(id);
  }

  @Post()
  @CheckAbility({ action: 'create', subject: 'Report' })
  create(@Body() dto: CreateReportDto, @Req() req: Request) {
    return this.reportService.create(dto, req.user!.userId);
  }
}

// ── 2. Service ──
@Injectable()
export class ReportService {
  private readonly logger = new Logger(ReportService.name);

  constructor(private prisma: PrismaService) {}

  async findAll(query: any, ability: AppAbility) {
    return this.prisma.report.findMany({
      where: accessibleBy(ability).Report,
    });
  }

  async findOne(id: string) {
    const report = await this.prisma.report.findUnique({ where: { id } });
    if (!report) throw new NotFoundException('Report not found');
    return report;
  }

  async create(dto: CreateReportDto, userId: string) {
    this.logger.log(`📊 Creating report for user ${userId}`);
    return this.prisma.report.create({ data: { ...dto, createdById: userId } });
  }
}
```

### Add a New Frontend Page

```typescript
// ── 1. Service (services/report.service.ts) ──
'use server';
import { apiClient } from '@/lib/api-client';
import { API } from '@/lib/endpoints';

export async function getReports() {
  return apiClient<Report[]>(API.REPORT.LIST);
}

// ── 2. Endpoint (lib/endpoints.ts) ──
REPORT: {
  LIST: '/report',
  DETAIL: (id: string) => `/report/${id}`,
},

// ── 3. Page (app/reports/page.tsx) ──
import { DashboardLayout } from '@/components/DashboardLayout';
import { getReports } from '@/services/report.service';
import { getCurrentUser } from '@/services/auth.service';
import { can } from '@/lib/permissions';

export default async function ReportsPage() {
  const [user, reports] = await Promise.all([
    getCurrentUser(),
    getReports(),
  ]);

  return (
    <DashboardLayout>
      <div className="page-container">
        <div className="page-header-row">
          <div className="page-header">
            <h1 className="page-title">Reports</h1>
          </div>
          {can(user.permissions, 'create', 'Report') && (
            <Button>New Report</Button>
          )}
        </div>
        {/* Table or cards here */}
      </div>
    </DashboardLayout>
  );
}

// ── 4. Nav item (lib/navigation.tsx) ── Add to NAV_ITEMS array:
{
  href: '/reports',
  label: 'Reports',
  section: 'platform',
  icon: ReportIcon,
  permission: { action: 'read', subject: 'Report' },
},
```

### Client Component with Permission Check

```typescript
'use client';
import { useAuthStore } from '@/stores/auth-store';
import { useAction } from '@/hooks/use-action';
import { deleteReport } from '@/services/report.service';

export function DeleteButton({ id }: { id: string }) {
  const { can } = useAuthStore();
  const { execute, pending } = useAction(deleteReport);

  if (!can('delete', 'Report')) return null;

  return (
    <button onClick={() => execute(id)} disabled={pending}>
      {pending ? 'Deleting...' : 'Delete'}
    </button>
  );
}
```

